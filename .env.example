# Copy to .env and tailor to your local station.

# Optional path to pythonw.exe on Windows for start-grimoire.bat
# GRIMOIRE_PYTHONW=pythonw.exe

# Astronomical Ephemeris & Chaldean Planetary Hours
GRIMOIRE_TZ=UTC
GRIMOIRE_LAT=51.48
GRIMOIRE_LON=0.00
GRIMOIRE_SKY_LABEL=local

# Querent Framing
GRIMOIRE_QUERENT_NAME=the Querent
# GRIMOIRE_QUERENT_HARUSPEX_BIO=nocturnal scholar and technowitch...
# GRIMOIRE_QUERENT_PYTHIA_BIO=witch-scholar, keeper of spores and silicon...

# Scriptorium & Optional Household Entrails
GRIMOIRE_JOURNAL_DIR=./data/journal
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your_long_lived_access_token
# GRIMOIRE_EXTRA_ENV_FILES=
# GRIMOIRE_MAGTAG_LINE_PATH=
# GRIMOIRE_BIOMETRICS_URL=
# GRIMOIRE_BIOMETRICS_ARCHIVE_DIR=
# GRIMOIRE_DIGESTS_DIR=
# GRIMOIRE_DIGEST_CHANNELS=

# Optional Home Assistant Entity Overrides
# GRIMOIRE_HA_TEMP_ENTITIES=sensor.undergrowth_temperature
# GRIMOIRE_HA_RH_ENTITIES=sensor.undergrowth_humidity
# GRIMOIRE_HA_CO2_ENTITIES=sensor.undergrowth_co2
# GRIMOIRE_HA_HEAT_AUTO_ENTITY=automation.undergrowth_heat_mat
# GRIMOIRE_HA_PLUG_ENTITY=switch.undergrowth_heat_plug
# GRIMOIRE_HA_POWER_ENTITY=sensor.undergrowth_heat_power
# GRIMOIRE_SOIL_SENSOR_HINTS=soil,botanical
# GRIMOIRE_PLANT_LABEL=Botanical

# Model Backends
GRIMOIRE_HARUSPEX_MODEL=gemini-4-neon
# GRIMOIRE_DIRECTSDK_DIRS=
GRIMOIRE_LMS_BASE_URL=http://127.0.0.1:1234
# GRIMOIRE_LMS_EXE=~/.lmstudio/bin/lms
GRIMOIRE_PYTHIA_MODEL_ID=thedrummer_fallen-gemma3-27b-v1
